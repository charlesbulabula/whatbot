{
  "name": "whatbot",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp ordering bot for fresh spice delivery in Kinshasa (WhatsApp Cloud API + Express + SQLite)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/db/seed.js",
    "backup": "node src/db/backup.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10"
  }
}
