# ---------- Server ----------
PORT=3000
NODE_ENV=production
DB_PATH=./data/whatbot.db
TZ=Africa/Kinshasa

# ---------- WhatsApp Cloud API (Meta) ----------
# developers.facebook.com > your app > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=000000000000000
WA_TOKEN=EAAG...                       # permanent System User token
WA_VERIFY_TOKEN=change-me-webhook      # free string, paste the same one in Meta
WA_APP_SECRET=abcdef...                # App Settings > Basic > App Secret
WA_GRAPH_VERSION=v21.0

# ---------- Shop ----------
SHOP_NAME=Epices Fraiches
CURRENCY=FC
DELIVERY_FEE=2000
DELIVERY_ZONES=Gombe,Limete,Ngaliema,Bandalungwa,Kasa-Vubu,Lingwala,Kintambo
MOMO_ORANGE=0899000000
MOMO_AIRTEL=0999000000
MOMO_HOLDER=Charles B.
ADMIN_NOTIFY_NUMBER=243899000000       # receives new-order notifications

# ---------- Language ----------
DEFAULT_LOCALE=fr                      # fr (default) | en
AVAILABLE_LOCALES=fr,en

# ---------- Admin dashboard ----------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# ---------- Automation ----------
CART_REMINDER_MINUTES=10
WEEKLY_REMINDER_DAY=5                  # 0=Sunday ... 5=Friday
WEEKLY_REMINDER_HOUR=18
WEEKLY_STOCK_CAPACITY=0                # 0 = unlimited; otherwise orders/week before waitlist
