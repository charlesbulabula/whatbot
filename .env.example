# ---------- Server ----------
PORT=3023
HOST=127.0.0.1
NODE_ENV=production
DB_PATH=./data/whatbot.db
TZ=Africa/Kinshasa
PUBLIC_URL=https://bot.ll-aca.site

# ---------- WhatsApp Cloud API (Meta) ----------
# developers.facebook.com > your app > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_TOKEN=                              # permanent System User token
WA_VERIFY_TOKEN=                       # any random string, paste the same one in Meta
WA_APP_SECRET=                         # App Settings > Basic > App Secret
WA_GRAPH_VERSION=v21.0
WA_ENABLED=true                        # false = log messages instead of sending (local dev)
WA_BUSINESS_NUMBER=                    # the bot's own number (e.g. 243812345678), used in referral links

# Approved templates for messages sent outside the 24h window (see README).
# Leave empty to skip those messages when the window is closed.
WA_TEMPLATE_ORDER_UPDATE=
WA_TEMPLATE_WEEKLY_REMINDER=
WA_TEMPLATE_SURVEY=
WA_TEMPLATE_WAITLIST_OPEN=
WA_TEMPLATE_WINBACK=
WA_TEMPLATE_ADMIN_ALERT=
WA_TEMPLATE_LANG_FR=fr
WA_TEMPLATE_LANG_EN=en

# ---------- Shop ----------
# These seed the shop on a FRESH install only. Afterwards the Settings page of the
# dashboard owns them (shop name, opening hours, fees, mobile money, alerts), and
# the Delivery areas page owns the areas and their per-area fee.
SHOP_NAME=Epices Fraiches
CURRENCY=FC
DELIVERY_FEE=2000                      # default fee, per-area fees are set in the dashboard
DELIVERY_ZONES=Gombe,Limete,Ngaliema,Bandalungwa,Kasa-Vubu,Lingwala,Kintambo
SHOP_HOURS=                            # empty = 07:00-20:00 every day; "24/7" = always open
MOMO_ORANGE=
MOMO_AIRTEL=
MOMO_HOLDER=
ADMIN_NOTIFY_NUMBER=                   # your personal WhatsApp, receives payment proofs

# ---------- Email alerts (optional) ----------
# A backup for the WhatsApp alerts: WhatsApp refuses free-form messages outside the
# 24h window, email always arrives. The recipient and the on/off switch are in the
# dashboard (Settings > Alerts); only the server lives here.
SMTP_HOST=                             # e.g. smtp.gmail.com, ssl0.ovh.net, smtp.lws.fr
SMTP_PORT=587                          # 587 STARTTLS, 465 implicit TLS
SMTP_SECURE=                           # empty = deduced from the port
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                             # e.g. "Epices Fraiches <bot@ll-aca.site>"
ALERT_EMAIL=                           # default recipient, overridable in the dashboard

# ---------- Voice notes (optional) ----------
# Transcribes WhatsApp voice notes so the bot understands them like typed text.
# Empty provider or key = feature off (the bot asks for buttons instead).
STT_PROVIDER=                          # openai | deepgram
STT_API_KEY=
STT_MODEL=                             # whisper-1 (openai) | nova-2 (deepgram)
STT_BASE_URL=                          # for an OpenAI-compatible endpoint
STT_LANGUAGE=fr

# ---------- Free-text orders (optional) ----------
# "2 tas moyens de tomates et un petit gingembre" -> cart, confirmed by the customer.
ANTHROPIC_API_KEY=                     # empty = feature off, buttons only
ANTHROPIC_MODEL=claude-opus-5
AI_DAILY_LIMIT_PER_CUSTOMER=30         # cost guard

# ---------- Location ----------
GEOCODING_ENABLED=true                 # shared GPS location -> delivery zone (OpenStreetMap, free)

# ---------- Language ----------
DEFAULT_LOCALE=fr                      # fr (default) | en
AVAILABLE_LOCALES=fr,en,ln          # fr | en | ln (lingala)

# ---------- Loyalty ----------
REFERRAL_REWARD=1000                   # credit for both referrer and referee (0 = off)
LOYALTY_EVERY=5                        # every Nth paid order...
LOYALTY_REWARD=2000                    # ...earns this credit (0 = off)

# ---------- Admin dashboard ----------
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Automation ----------
CART_REMINDER_MINUTES=10
WEEKLY_REMINDER_DAY=5                  # 0=Sunday ... 5=Friday
WEEKLY_REMINDER_HOUR=18
WEEKLY_STOCK_CAPACITY=0                # 0 = unlimited; otherwise orders per 7 days before waitlist
